# ---- Email (Gmail) ----
# Your Gmail address that sends the alerts
GMAIL_SENDER=youraddress@gmail.com
# Gmail App Password (16 chars, NOT your normal password).
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx
# Optional SMTP overrides (defaults are fine for Gmail)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# ---- Cron protection ----
# Random string; the same value goes in your GitHub Actions secret.
# Generate with: openssl rand -hex 16
CRON_SECRET=replace-with-random-string

# ---- Redis storage (auto-set by Vercel when you connect a Redis store) ----
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
